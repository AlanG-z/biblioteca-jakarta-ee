# ============================================================
# Build de Maven
# ============================================================
target/

# ============================================================
# Imágenes subidas desde el formulario de libro
# (viven en el WAR desplegado y se pierden al redeploy; se
#  conserva solo .gitkeep para que Maven incluya la carpeta)
# ============================================================
src/main/webapp/img/portadas/*
!src/main/webapp/img/portadas/.gitkeep

