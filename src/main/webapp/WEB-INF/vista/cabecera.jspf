<%-- ============================================================
     Fragmento de cabecera: HTML, CSS y menú de navegación.
     Estructura c:choose/c:when/c:otherwise corregida para evitar PWC6305.
     Todas las etiquetas c:when/c:otherwise son hermanos (mismo nivel).
     ============================================================ --%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Biblioteca Virtual</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css?v=2">
</head>
<body>

<header class="header">
    <div class="contenedor">
        <nav class="navbar">
            <!-- Logo -->
            <a href="${pageContext.request.contextPath}/catalogo" class="logo">
                Biblioteca<span>Virtual</span>
            </a>
                <div>
                    
                </div>

            <!-- Enlaces cliente (solo si hay sesión) -->
            <c:choose>
                <c:when test="${not empty usuario}">
                    <ul class="nav-links">
                        <li><a href="${pageContext.request.contextPath}/catalogo">Catálogo</a></li>
                        <li><a href="${pageContext.request.contextPath}/mis-prestamos">Mis préstamos</a></li>
                        <li>${usuario.nombre}</li>
                        <li><a href="${pageContext.request.contextPath}/logout">Cerrar sesión</a></li>
                    </ul>
                </c:when>
                <c:otherwise>
                    <ul class="nav-links">
                         <li><a href="${pageContext.request.contextPath}/catalogo">Catálogo</a></li>
                        <li><a href="${pageContext.request.contextPath}/login">Iniciar sesión</a></li>
                        <li><a href="${pageContext.request.contextPath}/registro">Regístrate</a></li>
                       
                    </ul>
                </c:otherwise>
            </c:choose>

            <!-- Dropdown Administración -->
            <c:choose>
                <c:when test="${esAdmin}">
                    <div class="dropdown">
                        <span class="dropdown-trigger">Administración</span>
                        <div class="dropdown-content">
                            <a href="${pageContext.request.contextPath}/categoria/listar">Categorías</a>
                            <a href="${pageContext.request.contextPath}/libro/listar">Libros</a>
                            <%-- <a href="${pageContext.request.contextPath}/usuario/listar">Usuarios</a>--%>
                            <a href="${pageContext.request.contextPath}/prestamo/listar">Préstamos</a>
                            <a href="${pageContext.request.contextPath}/multa/listar">Multas</a>
                        </div>
                    </div>
                </c:when>
                <c:otherwise>
                    <!-- Botón hamburguesa para móvil -->
                    <button class="hamburger" aria-label="Menú principal">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                </c:otherwise>
            </c:choose>
        </nav>
    </div>
</header>

<main class="contenido">